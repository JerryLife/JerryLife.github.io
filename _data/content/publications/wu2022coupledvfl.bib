    pdf = "https://proceedings.neurips.cc/paper\_files/paper/2022/file/84b744165a0597360caad96b06e69313-Paper-Conference.pdf",
    code = "https://github.com/Xtra-Computing/FedSim",
    supp = "https://arxiv.org/pdf/2106.06312.pdf",
    google_scholar_id = "YsMSGLbcyi4C",
