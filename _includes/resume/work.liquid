<ul class="card-text font-weight-light list-group list-group-flush">
  {% assign work = data[1] | sort: 'startDate' | reverse %}
  {% for content in work %}
    <li class="list-group-item">
      <div class="row">
        <div class="col-xs-2 cl-sm-2 col-md-2 text-center date-column">
          {% if content.startDate %}
            {% assign startDate = content.startDate | split: '-' | slice: 0, 2 | join: '.' %}
            {% assign endDate = content.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
            {% assign date = startDate | append: ' - ' %}
            {% assign date = date | append: endDate %}
          {% else %}
            {% assign date = '' %}
          {% endif %}
          <table class="table-cv">
            <tbody>
              <tr>
                <td>
                  <span class="badge font-weight-bold danger-color-dark text-uppercase align-middle" style="min-width: 75px"> {{ date }} </span>
                </td>
              </tr>
              {% if content.location %}
                <tr>
                  <td>
                    <p class="location">
                      <i class="fa-solid fa-location-dot iconlocation"></i>
                      {{ content.location }}
                    </p>
                  </td>
                </tr>
              {% endif %}
            </tbody>
          </table>
        </div>
        <div class="col-xs-10 cl-sm-10 col-md-10 mt-2 mt-md-0">
          <h6 class="title font-weight-bold ml-1 ml-md-4 mb-3">
            {% if content.url != blank %}
              <a href="{{ content.url }}">{{ content.name }}</a>
            {% else %}
              {{ content.name }}
            {% endif %}
          </h6>
          {% for subjob in content.subjobs %}
            <div class="ml-1 ml-md-4{% unless forloop.first %} mt-3{% endunless %}">
              {% if subjob.startDate %}
                {% assign subjob_start = subjob.startDate | split: '-' | slice: 0, 2 | join: '.' %}
                {% assign subjob_end = subjob.endDate | split: '-' | slice: 0, 2 | join: '.' | default: 'Present' %}
                {% assign subjob_date = subjob_start | append: ' - ' | append: subjob_end %}
              {% else %}
                {% assign subjob_date = '' %}
              {% endif %}
              <h6 class="font-weight-bold mb-1" style="font-size: 0.95rem">
                {{ subjob.position }}{% if subjob_date != '' %}<span class="font-weight-normal text-muted"> | {{ subjob_date }}</span>{% endif %}
              </h6>
              {% if subjob.summary != blank %}
                <div style="font-size: 0.95rem; font-style: italic">{{ subjob.summary | markdownify | remove: '<p>' | remove: '</p>' }}</div>
              {% endif %}
              {% if subjob.highlights and subjob.highlights.size > 0 %}
                <ul class="items">
                  {% for item in subjob.highlights %}
                    <li>
                      <span class="item">{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</span>
                    </li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
