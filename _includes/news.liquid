{% assign news_items = site.news | sort: 'date' | reverse %}
{% assign news_limit = include.limit | default: news_items.size %}
<div class="faculty-news{% unless include.compact %} faculty-news-archive{% endunless %}">
  {% for item in news_items limit: news_limit %}
    <article class="faculty-news-item">
      <time datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
      <div class="faculty-news-content">
        {% if include.compact %}
          {% if item.inline %}
            {% assign news_intro = item.content | split: '</p>' | first | append: '</p>' %}
            {% assign news_details = item.content | remove_first: news_intro | strip %}
            {% if news_details != blank %}
              <details class="faculty-news-disclosure">
                <summary>
                  <span>{{ news_intro | remove: '<p>' | remove: '</p>' }}</span>
                  <span class="faculty-news-toggle" aria-hidden="true"
                    ><span class="faculty-news-expand">{{ site.data.content.pages.news.expand_label | escape }}</span
                    ><span class="faculty-news-collapse">{{ site.data.content.pages.news.collapse_label | escape }}</span></span
                  >
                </summary>
                <div class="faculty-news-details">{{ news_details }}</div>
              </details>
            {% else %}
              {{ item.content }}
            {% endif %}
          {% else %}
            <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
          {% endif %}
        {% elsif item.inline %}
          {{ item.content }}
        {% else %}
          <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
        {% endif %}
      </div>
    </article>
  {% endfor %}
</div>
