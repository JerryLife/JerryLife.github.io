<div class="faculty-research-map" role="group" aria-label="{{ page.copy.research_heading | escape }}">
  {% for direction in site.data.content.home.directions %}
    <div class="faculty-research-stage faculty-research-{{ direction.illustration | escape }}">
      {% include research_illustration.liquid icon=direction.illustration id=direction.id description=direction.illustration_description %}
      <div class="faculty-research-stage-label">
        <p>{{ direction.stage_label | escape }}</p>
      </div>
    </div>
  {% endfor %}
</div>
