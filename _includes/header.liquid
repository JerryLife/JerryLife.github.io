<header>
  {% assign profile_name = site.data.content.profile.basics.name %}
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-md {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    aria-label="Main navigation"
  >
    <div class="container">
      <a class="navbar-brand" href="{{ '/' | relative_url }}">{{ profile_name }}</a>
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Open navigation"
        data-faculty-menu
      >
        <span class="icon-bar top-bar"></span><span class="icon-bar middle-bar"></span><span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a
              class="nav-link"
              href="{{ '/' | relative_url }}"
              {% if page.permalink == '/' %}
                aria-current="page"
              {% endif %}
            >
              {{- site.data.content.pages.home.title | escape -}}
            </a>
          </li>
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for item in sorted_pages %}
            {% if item.nav and item.autogen == null %}
              {% assign nav_url = item.nav_url | default: item.url %}
              <li class="nav-item {% if page.url == item.url %}active{% endif %}">
                <a
                  class="nav-link"
                  href="{{ nav_url | relative_url }}"
                  {% if page.url == item.url %}
                    aria-current="page"
                  {% endif -%}
                  {% if item.nav_url contains '.pdf' %}
                    target="_blank" rel="noopener noreferrer" aria-label="{{ site.data.content.pages.home.cv_open_label | escape }}"
                  {% endif %}
                >
                  {{- item.title -}}
                </a>
              </li>
            {% endif %}
          {% endfor %}
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" type="button" title="Change color theme" aria-label="Change color theme">
                <i class="ti ti-moon-filled" id="light-toggle-dark" aria-hidden="true"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light" aria-hidden="true"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
</header>
<script>
  (() => {
    const button = document.querySelector('[data-faculty-menu]');
    const menu = document.getElementById('navbarNav');
    function setMenu(open) {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      button.classList.toggle('collapsed', !open);
      menu.classList.toggle('show', open);
    }
    button.addEventListener('click', () => setMenu(button.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setMenu(false);
        button.focus();
      }
    });
    button.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenu(false);
    });
  })();
</script>
