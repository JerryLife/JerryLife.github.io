{% case include.icon %}
{% when 'data' %}
<svg viewBox="0 0 200 112" role="img" aria-labelledby="{{ include.id | escape }}-diagram-title" focusable="false">
      <title id="{{ include.id | escape }}-diagram-title">{{ include.description | escape }}</title>
      <defs>
        <g id="{{ include.id | escape }}-database" class="faculty-research-glyph">
          <path d="M0 7v28c0 9 32 9 32 0V7" />
          <ellipse cx="16" cy="7" rx="16" ry="6" />
          <path d="M0 20c0 9 32 9 32 0M0 29c0 9 32 9 32 0" fill="none" />
        </g>
      </defs>
      <path class="faculty-research-edges" d="M38 75 100 35 162 75Z" />
      <use href="#{{ include.id | escape }}-database" x="22" y="53" />
      <use href="#{{ include.id | escape }}-database" x="84" y="13" />
      <use href="#{{ include.id | escape }}-database" x="146" y="53" />
    </svg>
{% when 'models' %}
<svg viewBox="0 0 200 112" role="img" aria-labelledby="{{ include.id | escape }}-diagram-title" focusable="false">
      <title id="{{ include.id | escape }}-diagram-title">{{ include.description | escape }}</title>
      <defs>
        <g id="{{ include.id | escape }}-model" class="faculty-research-glyph">
          <rect width="44" height="36" rx="6" />
          <path d="m9 11 13 7-13 7m26-14-13 7 13 7" fill="none" stroke-width="1.2" />
          <g stroke-width="1.3">
            <circle cx="9" cy="11" r="2.5" />
            <circle cx="9" cy="25" r="2.5" />
            <circle cx="22" cy="18" r="3" />
            <circle cx="35" cy="11" r="2.5" />
            <circle cx="35" cy="25" r="2.5" />
          </g>
        </g>
      </defs>
      <path class="faculty-research-edges" d="M40 74 100 32 160 74Z" />
      <use href="#{{ include.id | escape }}-model" x="18" y="56" />
      <use href="#{{ include.id | escape }}-model" x="78" y="14" />
      <use href="#{{ include.id | escape }}-model" x="138" y="56" />
    </svg>
{% when 'agents' %}
<svg viewBox="0 0 200 112" role="img" aria-labelledby="{{ include.id | escape }}-diagram-title" focusable="false">
      <title id="{{ include.id | escape }}-diagram-title">{{ include.description | escape }}</title>
      <defs>
        <g id="{{ include.id | escape }}-agent" class="faculty-research-glyph">
          <path d="M17 3v5" fill="none" />
          <circle cx="17" cy="2" r="2" />
          <rect x="3" y="8" width="28" height="22" rx="7" />
          <g fill="currentColor" stroke="none">
            <circle cx="12" cy="18" r="1.7" />
            <circle cx="22" cy="18" r="1.7" />
          </g>
          <path d="M13 24h8M1 42v-2c0-10 32-10 32 0v2" fill="none" />
        </g>
      </defs>
      <path class="faculty-research-edges" d="M100 47v25M52 80l36 5m24 0 36-5" />
      <use href="#{{ include.id | escape }}-agent" x="20" y="46" />
      <use href="#{{ include.id | escape }}-agent" x="83" y="7" />
      <use href="#{{ include.id | escape }}-agent" x="146" y="46" />
      <g class="faculty-research-glyph">
        <path d="M61 40h13a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3h-6l-5 4v-4h-2a3 3 0 0 1-3-3v-7a3 3 0 0 1 3-3Z" />
        <path d="M126 40h13a3 3 0 0 1 3 3v7a3 3 0 0 1-3 3h-2v4l-5-4h-6a3 3 0 0 1-3-3v-7a3 3 0 0 1 3-3Z" />
        <path d="M63 46h9m56 0h9" fill="none" />
        <circle cx="100" cy="85" r="12" />
        <path d="m94 85 4 4 8-9" fill="none" />
      </g>
    </svg>
{% endcase %}
