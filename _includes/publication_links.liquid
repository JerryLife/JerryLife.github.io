<span class="publication-links">
  {% if include.paper_link != blank -%}
    <a href="{{ include.paper_link }}">{{ site.data.content.pages.publications.paper_label | escape }}</a>
  {%- endif %}
  {% if include.paper.code -%}
    <a href="{{ include.paper.code }}">{{ site.data.content.pages.publications.code_label | escape }}</a>
  {%- endif %}
  {% if include.paper.website -%}
    <a href="{{ include.paper.website }}">{{ site.data.content.pages.publications.website_label | escape }}</a>
  {%- endif %}
  {% if include.paper.bibtex_show -%}
    <button
      type="button"
      class="publication-bib-toggle"
      aria-expanded="false"
      aria-controls="{{ include.paper_id }}-bib"
      aria-label="Show BibTeX for {{ include.paper.title | strip_html | escape }}"
    >
      {{ site.data.content.pages.publications.bib_label | escape }}
    </button>
  {%- endif %}
</span>
