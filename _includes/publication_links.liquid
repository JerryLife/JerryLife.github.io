<span class="publication-links">
  {% if include.paper_link != blank %}<a href="{{ include.paper_link }}">Paper</a>{% endif %}
  {% if include.paper.code %}<a href="{{ include.paper.code }}">Code</a>{% endif %}
  {% if include.paper.website %}<a href="{{ include.paper.website }}">Website</a>{% endif %}
  {% if include.paper.bibtex_show %}<button type="button" class="publication-bib-toggle" aria-expanded="false" aria-controls="{{ include.paper_id }}-bib" aria-label="Show BibTeX for {{ include.paper.title | strip_html | escape }}">Bib</button>{% endif %}
</span>
