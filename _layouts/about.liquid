---
layout: default
---
{% assign profile = site.data.content.profile %}
{% assign home = site.data.content.home %}
{% assign research_publications = site.data.generated.content.cv.publications.entries %}
<article class="faculty-home">
  <header class="faculty-hero">
    <div class="faculty-hero-copy">
      <h1>{{ profile.basics.name }} <span class="faculty-chinese" lang="zh">吴肇敏</span></h1>
      <div class="faculty-affiliation">{{ profile.web_about.subtitle }}</div>
      <div class="faculty-bio">{{ profile.web_about.body | markdownify }}</div>
      <div class="faculty-contact" aria-label="Contact and profiles">
        <span class="faculty-email">Email: {{ profile.socials.email }}</span>
        <a href="https://scholar.google.com/citations?user={{ profile.socials.scholar_userid }}">Google Scholar <span aria-hidden="true">↗</span></a>
        <a href="{{ '/assets/pdf/ZhaominWu.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer" aria-label="Open CV (PDF) in a new tab">CV <span class="faculty-file-type">PDF</span> <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <figure class="faculty-portrait">
      <img src="{{ profile.web_about.image | prepend: '/assets/img/' | relative_url }}" alt="Portrait of {{ profile.basics.name }}" width="792" height="792" fetchpriority="high">
    </figure>
  </header>

  <section class="faculty-working" aria-labelledby="working-heading">
    <div class="faculty-working-heading">
      <h2 id="working-heading">We are hiring!</h2>
      <a class="faculty-button" href="{{ '/supervision/#openings-heading' | relative_url }}">Openings <span aria-hidden="true">→</span></a>
    </div>
    {{ home.working_with_me | markdownify }}
  </section>

  <section class="faculty-section faculty-research" aria-labelledby="research-heading">
    <div class="faculty-section-heading">
      <h2 id="research-heading">Research Directions</h2>
      <a class="faculty-text-link" href="{{ '/publications/' | relative_url }}">Explore publications <span aria-hidden="true">→</span></a>
    </div>
    {% include research_path.liquid %}
    <div class="faculty-directions">
      {% for direction in home.directions %}
        <article class="faculty-direction" id="{{ direction.id }}">
          <h3>{{ direction.title }}</h3>
          <p class="faculty-direction-description">{{ direction.description | escape }}</p>
          {% for subcategory in direction.subcategories %}
            <div class="faculty-research-subcategory">
              <h4>{{ subcategory.title | escape }}</h4>
              <div class="faculty-publication-badges" aria-label="{{ subcategory.title | escape }} publications in {{ direction.title | escape }}">
                {% for publication_key in subcategory.publications %}
                  {% assign research_paper = research_publications | where: 'key', publication_key | first %}
                  {% if research_paper %}
                    <a class="faculty-publication-badge" href="{{ '/publications/' | relative_url }}#{{ research_paper.key }}" title="{{ research_paper.title | escape }}" aria-label="{{ research_paper.venue | escape }}: {{ research_paper.title | escape }}">{{ research_paper.venue }} <span aria-hidden="true">↗</span></a>
                  {% endif %}
                {% endfor %}
              </div>
            </div>
          {% endfor %}
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="faculty-section" aria-labelledby="recent-news-heading">
    <div class="faculty-section-heading"><h2 id="recent-news-heading">Recent News</h2></div>
    {% include news.liquid limit=10 compact=true %}
    <a class="faculty-text-link faculty-section-link" href="{{ '/news/' | relative_url }}">View all news <span aria-hidden="true">→</span></a>
  </section>

  <section class="faculty-section" aria-labelledby="honors-heading">
    <div class="faculty-section-heading"><h2 id="honors-heading">Selected Honors</h2></div>
    <ul class="faculty-honors">
      {% for honor in home.honors %}
        {% if honor.source_title %}
          {% assign award = site.data.content.cv.awards.entries | where: 'title', honor.source_title | first %}
          {% if award %}
            <li><span class="faculty-honor-year">{{ award.date }}</span><div><strong>{{ award.title }}</strong><span class="faculty-honor-detail">{{ honor.detail }}</span></div></li>
          {% endif %}
        {% else %}
          <li><span class="faculty-honor-year">{{ honor.year }}</span><div><strong>{{ honor.title }}</strong><span class="faculty-honor-detail">{{ honor.detail }}</span></div></li>
        {% endif %}
      {% endfor %}
    </ul>
  </section>

</article>
