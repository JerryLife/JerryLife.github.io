---
layout: default
---
{% assign content_view = site.data.generated.content %}
{% assign generated_profile = content_view.profile %}
{% if generated_profile and generated_profile.basics %}
  {% assign profile_content = generated_profile %}
{% else %}
  {% assign profile_content = site.data.content.profile %}
{% endif %}
{% assign profile_basics = profile_content.basics %}
{% assign web_about = profile_content.web_about %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if profile_basics.name %}
        {% assign name_parts = profile_basics.name | split: ' ' %}
        <span class="font-weight-bold">{{ name_parts.first }}</span>{% for name_part in name_parts offset: 1 %} {{ name_part }}{% endfor %}
      {% elsif site.title == 'blank' %}
        <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }} {{ site.last_name }}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    {% if web_about.subtitle %}
      <p class="desc">{{ web_about.subtitle }}</p>
    {% elsif page.subtitle %}
      <p class="desc">{{ page.subtitle }}</p>
    {% endif %}
  </header>

  <article>
    {% if web_about.image or page.profile %}
      <div class="profile float-{% if web_about.align == 'left' or page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% assign profile_image = web_about.image | default: page.profile.image %}
        {% if profile_image %}
          {% assign profile_image_path = profile_image | prepend: 'assets/img/' %}
          {% if web_about.image_circular or page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=profile_basics.name
            cache_bust=true
          %}
        {% endif %}
        {% assign profile_more_info = web_about.more_info | default: page.profile.more_info %}
        {% if profile_more_info %}
          <div class="more-info">{{ profile_more_info }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="clearfix">
      {% if web_about.body %}
        {{ web_about.body | markdownify }}
      {% else %}
        {{ content }}
      {% endif %}
    </div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Selected Publications</a>
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
